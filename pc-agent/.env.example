CAFEOS_SERVER_URL=http://<ADMIN-PC-LAN-IP>:8080
CAFEOS_BRANCH_ID=
CAFEOS_PC_ID=
CAFEOS_AGENT_TOKEN=
CAFEOS_HEARTBEAT_INTERVAL_SECONDS=15
CAFEOS_REQUEST_TIMEOUT_SECONDS=10
CAFEOS_VERIFY_TLS=true
CAFEOS_AGENT_VERSION=0.2.0
CAFEOS_LOG_LEVEL=INFO
CAFEOS_ALLOW_PLAINTEXT_TOKEN_FALLBACK=false
